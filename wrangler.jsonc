// classboard 기본판 설정 (R2 없음)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "ClassRoom" },
      { "name": "PROBE", "class_name": "ProbeRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClassRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ProbeRoom"] }
  ],
  // workers.dev 주소는 쓰고, 브랜치별 미리보기 주소는 만들지 않음
  // 대시보드에서 넣은 변수를 배포할 때 지우지 않음(SETUP_KEY 를 일반 변수로 넣은 경우 대비)
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
